{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/splch/qutip-trap/blob/main/docs/schemas/runspec.schema.json",
  "title": "qutip-trap RunSpec",
  "description": "The record RunSpec.to_dict() writes and RunSpec.from_dict() reads (schema version 1): the unit of submission of Machine.submit, with the circuit (parameters in radians), the shots and the seed, the hash of the machine it was made for, and the policy spelled out as the three option objects and the level (docs/api_implementation_plan.md 3.1). Tuples are lists and integer keys strings.",
  "type": "object",
  "required": [
    "schema_version",
    "qutip_trap_version",
    "machine_hash",
    "label",
    "circuit",
    "shots",
    "seed",
    "keep_final_state",
    "level",
    "physics",
    "numerics",
    "readout"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "qutip_trap_version": {
      "type": "string"
    },
    "machine_hash": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "circuit": {
      "type": "object",
      "required": [
        "n_qubits",
        "ops",
        "measure",
        "registers"
      ],
      "additionalProperties": false,
      "properties": {
        "n_qubits": {
          "type": "integer",
          "minimum": 1
        },
        "ops": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "qubits",
              "params"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "qubits": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "params": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              }
            }
          }
        },
        "measure": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "registers": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "shots": {
      "type": "integer",
      "minimum": 1
    },
    "seed": {
      "type": "integer"
    },
    "keep_final_state": {
      "type": "boolean"
    },
    "level": {
      "type": "string",
      "enum": [
        "auto",
        "JOINT_EXACT",
        "GATE_LOCAL"
      ]
    },
    "physics": {
      "type": "object",
      "required": [
        "noise",
        "internal_levels",
        "scattering",
        "scattering_recoil",
        "intensity_noise_channels",
        "hardware_chain",
        "stark_compensation",
        "crosstalk_suppression",
        "entangler",
        "extra_channels",
        "builder",
        "t0_s",
        "shot_period_s"
      ],
      "additionalProperties": false,
      "properties": {
        "noise": {
          "type": "boolean"
        },
        "internal_levels": {
          "type": "integer"
        },
        "scattering": {
          "type": "string"
        },
        "scattering_recoil": {
          "type": "string"
        },
        "intensity_noise_channels": {
          "type": "boolean"
        },
        "hardware_chain": {
          "type": "boolean"
        },
        "stark_compensation": {
          "type": "boolean"
        },
        "crosstalk_suppression": {
          "type": "string"
        },
        "entangler": {
          "type": "string"
        },
        "extra_channels": {
          "type": "array",
          "maxItems": 0
        },
        "builder": {
          "type": [
            "object",
            "null"
          ]
        },
        "t0_s": {
          "type": "number"
        },
        "shot_period_s": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "numerics": {
      "type": "object",
      "required": [
        "integration",
        "truncation",
        "trajectories",
        "gate_local",
        "parallel",
        "convergence_check"
      ],
      "additionalProperties": false,
      "properties": {
        "integration": {
          "type": "object",
          "required": [
            "atol",
            "rtol",
            "nsteps",
            "integrators",
            "rotating_frame",
            "propagator_cache",
            "store_marginals"
          ],
          "additionalProperties": false,
          "properties": {
            "atol": {
              "type": "number"
            },
            "rtol": {
              "type": "number"
            },
            "nsteps": {
              "type": "integer"
            },
            "integrators": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "rotating_frame": {
              "type": "boolean"
            },
            "propagator_cache": {
              "type": "boolean"
            },
            "store_marginals": {
              "type": "boolean"
            }
          }
        },
        "truncation": {
          "type": "object",
          "required": [
            "joint_dimension_max",
            "nnz_max",
            "mode_dimension_max",
            "boundary_population_max",
            "freeze_chi_max_rad",
            "freeze_alpha_max",
            "branch_weight_min",
            "margin_check",
            "margin_element_tol",
            "caps",
            "enr_group",
            "space"
          ],
          "additionalProperties": false,
          "properties": {
            "joint_dimension_max": {
              "type": "integer"
            },
            "nnz_max": {
              "type": "integer"
            },
            "mode_dimension_max": {
              "type": "integer"
            },
            "boundary_population_max": {
              "type": "number"
            },
            "freeze_chi_max_rad": {
              "type": "number"
            },
            "freeze_alpha_max": {
              "type": "number"
            },
            "branch_weight_min": {
              "type": "number"
            },
            "margin_check": {
              "type": "boolean"
            },
            "margin_element_tol": {
              "type": [
                "number",
                "null"
              ]
            },
            "caps": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": {
                "type": "integer",
                "minimum": 2
              }
            },
            "enr_group": {
              "type": [
                "array",
                "null"
              ],
              "minItems": 2,
              "maxItems": 2
            },
            "space": {
              "type": "null"
            }
          }
        },
        "trajectories": {
          "type": "object",
          "required": [
            "lindblad_method",
            "mesolve_dimension_max",
            "ntraj",
            "improved_sampling",
            "trajectory_target_tol",
            "e_ops_for_target_tol"
          ],
          "additionalProperties": false,
          "properties": {
            "lindblad_method": {
              "type": "string"
            },
            "mesolve_dimension_max": {
              "type": "integer"
            },
            "ntraj": {
              "type": "integer"
            },
            "improved_sampling": {
              "type": "boolean"
            },
            "trajectory_target_tol": {
              "type": [
                "number",
                "null"
              ]
            },
            "e_ops_for_target_tol": {
              "type": "boolean"
            }
          }
        },
        "gate_local": {
          "type": "object",
          "required": [
            "map_accuracy",
            "crosstalk_threshold",
            "register_dm_max_qubits",
            "register_ensemble",
            "tomography_isometry",
            "tomography_dropped_weight_max",
            "tomography_tolerance_keyed"
          ],
          "additionalProperties": false,
          "properties": {
            "map_accuracy": {
              "type": "number"
            },
            "crosstalk_threshold": {
              "type": "number"
            },
            "register_dm_max_qubits": {
              "type": "integer"
            },
            "register_ensemble": {
              "type": "integer"
            },
            "tomography_isometry": {
              "type": "boolean"
            },
            "tomography_dropped_weight_max": {
              "type": [
                "number",
                "null"
              ]
            },
            "tomography_tolerance_keyed": {
              "type": "boolean"
            }
          }
        },
        "parallel": {
          "type": "object",
          "required": [
            "map",
            "workers",
            "samples",
            "addressing"
          ],
          "additionalProperties": false,
          "properties": {
            "map": {
              "type": "string"
            },
            "workers": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "samples": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "addressing": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        },
        "convergence_check": {
          "type": "boolean"
        }
      }
    },
    "readout": {
      "type": "object",
      "required": [
        "mode",
        "discriminator",
        "povm_samples"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string"
        },
        "discriminator": {
          "type": "null"
        },
        "povm_samples": {
          "type": "integer"
        }
      }
    }
  }
}
